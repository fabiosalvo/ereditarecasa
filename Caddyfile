{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	# I PDF si scaricano dopo il consenso: niente indicizzazione
	header /pdf/* X-Robots-Tag "noindex"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
