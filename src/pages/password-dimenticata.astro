---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Password dimenticata" description="Reimposta la password del tuo account EreditareCasa." noindex>
  <PageHead title="Password dimenticata" crumbs={[{ name: 'Accedi', href: '/accedi/' }, { name: 'Password dimenticata', href: '/password-dimenticata/' }]}>
    Inserisci l'email del tuo account: ti mandiamo un link per scegliere una nuova password, valido per un'ora.
  </PageHead>
  <div class="wrap read">
    <form class="form" id="pw-form" novalidate>
      <div class="field"><label for="pw-email">Email</label><input id="pw-email" name="email" type="email" autocomplete="email" required /></div>
      <p class="form-error" role="alert" id="pw-err"></p>
      <button class="btn" type="submit">Invia il link</button>
    </form>
    <p class="notice" id="pw-ok" hidden>Se l'indirizzo è registrato, riceverai a breve un'email con il link. Controlla anche lo spam.</p>
  </div>
</Base>
<script>
  import { api } from '../scripts/accesso';
  const f = document.getElementById('pw-form') as HTMLFormElement;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
    if (!email) return void (document.getElementById('pw-err')!.textContent = "Inserisci l'email.");
    await api('password-dimenticata', { email });
    f.hidden = true;
    document.getElementById('pw-ok')!.hidden = false;
  });
</script>
