---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHead from '../../components/PageHead.astro';
---
<Base title="Strumenti gratuiti per la casa ereditata" description="Calcolatore delle imposte di successione, scadenzario della successione e valutazione gratuita della casa ereditata.">
  <PageHead title="Strumenti gratuiti" crumbs={[{ name: 'Strumenti', href: '/strumenti/' }]} />
  <div class="wrap">
    <div class="grid">
      <a class="card" href="/strumenti/scadenzario-successione/">
        <h3>Scadenzario della successione</h3>
        <p>Dalla data del decesso, tutte le scadenze in ordine, con promemoria via email.</p>
      </a>
      <a class="card" href="/strumenti/calcolatore-imposte-successione/">
        <h3>Calcolatore delle imposte</h3>
        <p>Imposta di successione, ipotecaria e catastale sulla casa ereditata.</p>
      </a>
      <a class="card" href="/modelli-lettere/">
        <h3>Modelli di lettera</h3>
        <p>12 lettere pronte per banca, utenze, condominio, inquilino, coeredi e uffici.</p>
      </a>
      <a class="card" href="/percorso/">
        <h3>Il tuo percorso</h3>
        <p>Otto domande e ottieni la checklist personalizzata con le tue scadenze.</p>
      </a>
      <a class="card" href="/osservatorio/">
        <h3>Osservatorio dati</h3>
        <p>Successioni, case ereditate e tasse in Italia e in Europa, con le fonti.</p>
      </a>
      <a class="card" href="/valuta-casa-ereditata/">
        <h3>Valutazione della casa</h3>
        <p>Quanto vale oggi la casa ereditata, gratis e senza impegno.</p>
      </a>
    </div>
  </div>
</Base>
