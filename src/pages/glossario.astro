---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GLOSSARIO } from '../data/glossario';

const sorted = [...GLOSSARIO].sort((a, b) => a.term.localeCompare(b.term, 'it'));
const ld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossario della casa ereditata',
  hasDefinedTerm: sorted.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.def })),
};
---
<Base title="Glossario della casa ereditata" description="I termini della successione spiegati in modo semplice: de cuius, voltura, legittima, comunione ereditaria, beneficio d'inventario e altri." jsonLd={[ld]}>
  <div class="wrap read prose">
    <Breadcrumbs items={[{ name: 'Glossario', href: '/glossario/' }]} />
    <h1>Glossario della casa ereditata</h1>
    <dl>
      {sorted.map((t) => (
        <>
          <dt id={t.id}><strong>{t.term}</strong></dt>
          <dd>{t.def}{t.link && <> <a href={t.link}>Approfondisci</a>.</>}</dd>
        </>
      ))}
    </dl>
  </div>
</Base>
