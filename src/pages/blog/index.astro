---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { FOTO_AREA } from '../../data/foto';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [first, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const minuti = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 220));
const categorie = [...new Set(posts.map((p) => p.data.categoria))];
---
<Base title="Blog: novità, tasse e mercato della casa ereditata" description="Novità normative, tasse, mercato immobiliare e consigli pratici per chi ha ereditato una casa. Articoli verificati sulle fonti ufficiali.">
  <PageHead title="Il blog della casa ereditata" crumbs={[{ name: 'Blog', href: '/blog/' }]} eyebrow="Novità e analisi">
    Riforme in arrivo, tasse, mercato e casi di famiglia: quello che cambia per chi eredita una casa, spiegato con i numeri e con le fonti.
  </PageHead>

  <section class="sec">
    <div class="wrap">
      {posts.length === 0 && <p class="lede">I primi articoli sono in arrivo.</p>}

      {first && (
        <a class="post-feature" href={`/blog/${first.id}/`}>
          <div class="post-feature__img card-media">
            <Image src={FOTO_AREA[first.data.foto].src} alt="" widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 60vw" loading="eager" />
          </div>
          <div class="post-feature__tx">
            <span class="eyebrow" style="margin:0">{first.data.categoria}</span>
            <h2 class="h-l">{first.data.title}</h2>
            <p class="lede">{first.data.description}</p>
            <p class="post-meta">{fmt(first.data.date)} · {minuti(first.body)} min di lettura</p>
          </div>
        </a>
      )}

      {categorie.length > 1 && (
        <div class="post-filter" role="group" aria-label="Filtra per categoria">
          <button type="button" class="chip chip--primary" data-cat="">Tutti</button>
          {categorie.map((c) => <button type="button" class="chip" data-cat={c}>{c}</button>)}
        </div>
      )}

      <div class="grid grid--3 post-grid">
        {rest.map((p) => (
          <a class="card card-photo" href={`/blog/${p.id}/`} data-cat={p.data.categoria}>
            <div class="card-media">
              <Image src={FOTO_AREA[p.data.foto].src} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" />
              <span class="badge">{p.data.categoria}</span>
            </div>
            <div class="card-body">
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <p class="post-meta">{fmt(p.data.date)} · {minuti(p.body)} min</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.post-filter [data-cat]');
  const cards = document.querySelectorAll<HTMLElement>('.post-grid [data-cat]');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.toggle('chip--primary', x === b));
      cards.forEach((c) => (c.hidden = !!b.dataset.cat && c.dataset.cat !== b.dataset.cat));
    }),
  );
</script>
