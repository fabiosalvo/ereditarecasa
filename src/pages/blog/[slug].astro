---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBox from '../../components/CtaBox.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { FOTO_AREA } from '../../data/foto';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}

const { entry, posts } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const fmt = (x: Date) => x.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const minuti = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220));
const url = `/blog/${entry.id}/`;

// Guide collegate: titolo letto dalla collezione delle guide
const guide = await getCollection('guide');
const { guideUrl, AREAS } = await import('../../data/site');
const collegate = d.guide
  .map((u) => guide.find((g) => guideUrl(g.data.area, g.data.slug) === u))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
// Articoli correlati: prima quelli che condividono guide o area, poi la stessa categoria, poi i più recenti
const area = (u: string) => AREAS.find((a) => u.startsWith(a.path))?.id ?? u;
const affinita = (p: (typeof posts)[number]) =>
  p.data.guide.filter((g) => d.guide.includes(g)).length * 3 +
  p.data.guide.filter((g) => d.guide.some((x) => area(x) === area(g))).length +
  (p.data.categoria === d.categoria ? 2 : 0);
const altri = posts
  .filter((p) => p.id !== entry.id)
  .map((p) => ({ p, s: affinita(p) }))
  .sort((a, b) => b.s - a.s || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((x) => x.p);

const ogImg = await getImage({ src: FOTO_AREA[d.foto].src, width: 1200, format: 'jpg' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  image: [new URL(ogImg.src, SITE.url).toString()],
  inLanguage: 'it-IT',
  mainEntityOfPage: new URL(url, SITE.url).toString(),
  author: { '@type': 'Organization', name: d.autore, url: `${SITE.url}/chi-siamo/` },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/logo.png` } },
  ...(d.fonti.length ? { citation: d.fonti.map((f) => f.url) } : {}),
};
---
<Base title={d.title} description={d.description} jsonLd={[ld]} ogType="article">
  <PageHead title={d.title} crumbs={[{ name: 'Blog', href: '/blog/' }, { name: d.title, href: url }]} eyebrow={d.categoria}>
    {d.description}
    <p class="meta" slot="after">
      {fmt(d.date)} · {d.autore} · {minuti} min di lettura
      {d.verified && <> · Verificato sulle fonti ufficiali il {fmt(d.verified)}</>}
    </p>
  </PageHead>

  <div class="wrap">
    <div class="layout-article">
      <article class="prose">
        <figure class="article-photo">
          <Image src={FOTO_AREA[d.foto].src} alt={FOTO_AREA[d.foto].alt} widths={[480, 720, 1000]} sizes="(max-width: 760px) 100vw, 720px" loading="eager" />
        </figure>
        <Content />

        {collegate.length > 0 && (
          <section>
            <h2>Approfondisci nelle guide</h2>
            <div class="grid grid--2">
              {collegate.map((g) => (
                <a class="card" href={guideUrl(g.data.area, g.data.slug)}>
                  <h3>{g.data.title}</h3>
                  <p>{g.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        {d.fonti.length > 0 && (
          <section class="fonti">
            <h2>Fonti</h2>
            <ul>{d.fonti.map((f) => <li><a href={f.url} rel="noopener" target="_blank">{f.title}</a></li>)}</ul>
          </section>
        )}

        <p class="disclaimer">
          Articolo di informazione generale aggiornato alla data indicata. Non sostituisce il parere di un avvocato, notaio o
          commercialista sul tuo caso. Hai trovato un errore? Scrivici dalla pagina <a href="/chi-siamo/">Chi siamo</a>.
        </p>
      </article>
      <aside class="aside" aria-label="Strumenti utili">
        <CtaBox variant="valutazione" />
        <CtaBox variant="imposte" />
      </aside>
    </div>

    {altri.length > 0 && (
      <section>
        <h2 class="h-m">Articoli correlati</h2>
        <div class="grid grid--3">
          {altri.map((p) => (
            <a class="card card-photo" href={`/blog/${p.id}/`}>
              <div class="card-media">
                <Image src={FOTO_AREA[p.data.foto].src} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" />
                <span class="badge">{p.data.categoria}</span>
              </div>
              <div class="card-body">
                <h3>{p.data.title}</h3>
                <p class="post-meta">{fmt(p.data.date)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <CtaBand />
</Base>
