---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Scegli una nuova password" description="Imposta una nuova password per il tuo account EreditareCasa." noindex>
  <PageHead title="Scegli una nuova password" crumbs={[{ name: 'Accedi', href: '/accedi/' }, { name: 'Nuova password', href: '/reimposta-password/' }]} />
  <div class="wrap read">
    <form class="form" id="rp-form" novalidate>
      <div class="field"><label for="rp-pw">Nuova password</label><input id="rp-pw" name="password" type="password" autocomplete="new-password" minlength="8" required /><p class="hint">Almeno 8 caratteri.</p></div>
      <p class="form-error" role="alert" id="rp-err"></p>
      <button class="btn" type="submit">Salva e accedi</button>
    </form>
  </div>
</Base>
<script>
  import { api } from '../scripts/accesso';
  const f = document.getElementById('rp-form') as HTMLFormElement;
  const err = document.getElementById('rp-err')!;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (f.elements.namedItem('password') as HTMLInputElement).value;
    if (password.length < 8) return void (err.textContent = 'La password deve avere almeno 8 caratteri.');
    const token = new URLSearchParams(location.search).get('token') ?? '';
    const res = await api('reimposta-password', { token, password });
    if (res.ok) location.href = '/area-riservata/';
    else err.textContent = res.error ?? 'Non è stato possibile cambiare la password.';
  });
</script>
