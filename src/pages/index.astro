---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { AREAS, SITE, PDF_COMPLETO } from '../data/site';
import GuidaDownload from '../components/GuidaDownload.astro';
import { FOTO_AREA, FOTO_HERO } from '../data/foto';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const ALL = await getCollection('guide');
const POSTS = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const GUIDE_N = ALL.length;
const COUNT: Record<string, number> = {};
for (const g of ALL) COUNT[g.data.area] = (COUNT[g.data.area] ?? 0) + 1;
const TOOLS = [
  { href: '/percorso/', title: 'Il tuo percorso', text: 'Otto domande e ottieni la checklist personalizzata con le tue scadenze.' },
  { href: '/strumenti/calcolatore-imposte-successione/', title: 'Calcolatore imposte', text: 'Imposta di successione, ipotecaria e catastale sulla casa.' },
  { href: '/strumenti/scadenzario-successione/', title: 'Scadenzario della successione', text: 'Dalla data del decesso, tutte le scadenze in ordine.' },
  { href: '/modelli-lettere/', title: 'Modelli di lettera', text: '12 lettere pronte per banca, utenze, condominio, inquilino e coeredi.' },
  { href: '/osservatorio/', title: 'Osservatorio dati', text: "Successioni e case ereditate in Italia, confronto con l'Europa." },
  { href: '/glossario/', title: 'Glossario', text: 'Le parole della successione spiegate in modo semplice.' },
];
---
<Base title={`${SITE.name}: hai ereditato una casa? Cosa fare, passo per passo`} description={SITE.description}>
  <section class="hero">
    <div class="hero__bg">
      <Image src={FOTO_HERO.src} alt={FOTO_HERO.alt} widths={[640, 960, 1280, 1600, 2000]} sizes="(max-width: 860px) 100vw, 70vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero__in">
      <div class="hero__tx">
        <span class="eyebrow">Guida alla casa ereditata</span>
        <h1 class="h-xl">Hai ereditato una casa? Ti diciamo cosa fare.</h1>
        <p class="lede">Successione, tasse, eredi da mettere d'accordo, vendita: tutto quello che serve, spiegato in modo semplice e con le scadenze giuste.</p>
        <div class="actions">
          <a class="btn" href="/percorso/">Crea il tuo percorso</a>
          <a class="btn btn-ghost" href="/valuta-casa-ereditata/">Valuta la casa</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="facts">
        <div><b class="num">505.000</b><span>successioni ogni anno in Italia, quasi tutte con una casa</span></div>
        <div><b class="num">11%</b><span>delle successioni paga l'imposta: per gli altri restano ipotecaria e catastale</span></div>
        <div><b class="num">{GUIDE_N}</b><span>guide verificate sulle fonti ufficiali, scaricabili in PDF</span></div>
        <div><b class="num">12</b><span>modelli di lettera pronti per banca, utenze, condominio e fratelli</span></div>
      </div>
      <p class="small" style="margin-top:16px;color:var(--muted)">Fonti: MEF, Dipartimento Finanze, anno 2024. <a class="link" href="/osservatorio/">Tutti i dati nell'Osservatorio</a></p>
    </div>
  </section>

  <section class="sec sec--sand" id="percorso" aria-labelledby="percorso-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Da dove partire</span>
          <h2 class="h-l" id="percorso-title">Tre domande, la tua strada</h2>
        </div>
        <p class="lede">Ogni eredità è diversa. Rispondi e ti indichiamo le guide da leggere per prime. Per la checklist completa con le tue scadenze, <a class="link" href="/percorso/">crea il percorso personale in 8 domande</a>.</p>
      </div>
      <form class="wizard" id="wizard">
        <fieldset>
          <legend>1. A che punto è la successione?</legend>
          <div class="choices">
            <label><input type="radio" name="stato" value="no" /><span>Non ancora iniziata</span></label>
            <label><input type="radio" name="stato" value="corso" /><span>In corso</span></label>
            <label><input type="radio" name="stato" value="fatta" /><span>Dichiarazione presentata</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>2. Gli eredi sono d'accordo su cosa fare della casa?</legend>
          <div class="choices">
            <label><input type="radio" name="accordo" value="solo" /><span>Sono l'unico erede</span></label>
            <label><input type="radio" name="accordo" value="si" /><span>Sì</span></label>
            <label><input type="radio" name="accordo" value="no" /><span>No</span></label>
          </div>
        </fieldset>
        <fieldset style="margin-bottom:0">
          <legend>3. Cosa vorresti fare?</legend>
          <div class="choices">
            <label><input type="radio" name="obiettivo" value="vendere" /><span>Vendere</span></label>
            <label><input type="radio" name="obiettivo" value="capire" /><span>Valutare le opzioni</span></label>
            <label><input type="radio" name="obiettivo" value="tenere" /><span>Tenerla o affittarla</span></label>
          </div>
        </fieldset>
        <div class="result" id="wizard-result" hidden aria-live="polite"></div>
      </form>
    </div>
  </section>

  <section class="sec" aria-labelledby="fasi-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Come funziona</span>
          <h2 class="h-l" id="fasi-title">Dal lutto alla decisione, in quattro fasi</h2>
        </div>
        <p class="lede">Le scadenze di legge non aspettano: alcune decisioni vanno prese nei primi tre mesi. Ecco l'ordine giusto, con la guida per ogni passo.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Primi passi</h3>
          <p>Conto del defunto, chiavi, utenze, testamento. Cosa fare nelle prime settimane senza accettare l'eredità per sbaglio.</p>
          <a class="link" href="/casa-ereditata/primi-passi/">Leggi la guida</a>
        </li>
        <li>
          <h3>Accettare o rinunciare</h3>
          <p>Accettazione pura, con beneficio d'inventario o rinuncia. Le conseguenze se ci sono debiti o un'ipoteca.</p>
          <a class="link" href="/casa-ereditata/accettare-rinunciare/">Leggi la guida</a>
        </li>
        <li>
          <h3>Successione e tasse</h3>
          <p>Dichiarazione entro 12 mesi, imposte, voltura catastale, agevolazioni prima casa. Con il calcolatore.</p>
          <a class="link" href="/casa-ereditata/successione/">Leggi la guida</a>
        </li>
        <li>
          <h3>Decidere cosa fare</h3>
          <p>Vendere, affittare o tenere. Mettere d'accordo i fratelli, comprare le loro quote, fissare il prezzo giusto.</p>
          <a class="link" href="/casa-ereditata/decidere/">Leggi la guida</a>
        </li>
      </ol>
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="aree-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Le guide</span>
          <h2 class="h-l" id="aree-title">Tutto sulla casa ereditata</h2>
        </div>
        <p class="lede">Dieci aree, quasi cinquanta guide. Ognuna indica la data di verifica, cita le fonti normative e si scarica in PDF da condividere con gli altri eredi.</p>
      </div>
      <div class="grid grid--3 grid--aree">
        {AREAS.map((a) => (
          <a class="card card-photo" href={a.path}>
            <div class="card-media">
              <Image src={FOTO_AREA[a.id].src} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" />
              <span class="badge">{COUNT[a.id] ?? 0} guide</span>
            </div>
            <div class="card-body">
              <h3>{a.title}</h3>
              <p>{a.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {POSTS.length > 0 && (
    <section class="sec" aria-labelledby="blog-title">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Dal blog</span>
            <h2 class="h-l" id="blog-title">Novità e analisi</h2>
          </div>
          <p class="lede">Riforme, tasse e mercato: cosa cambia per chi eredita una casa, con i numeri e le fonti. <a class="link" href="/blog/">Tutti gli articoli</a></p>
        </div>
        <div class="grid grid--3">
          {POSTS.map((p) => (
            <a class="card card-photo" href={`/blog/${p.id}/`}>
              <div class="card-media">
                <Image src={FOTO_AREA[p.data.foto].src} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" />
                <span class="badge">{p.data.categoria}</span>
              </div>
              <div class="card-body">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="ebook-title">
    <div class="wrap split">
      <div>
        <span class="eyebrow" style="margin:0">Guida gratuita in PDF</span>
        <h2 class="h-l" id="ebook-title">Tutta la casa ereditata in un unico documento</h2>
        <p class="lede">Successione, tasse, accettazione, eredi in disaccordo, vendita e gestione della casa: tutte le guide raccolte in un PDF da stampare, conservare e condividere.</p>
        <ul class="checks">
          <li>Scadenze e documenti in ordine</li>
          <li>Esempi di calcolo delle imposte</li>
          <li>Errori da evitare e checklist operative</li>
        </ul>
      </div>
      <GuidaDownload pdf={PDF_COMPLETO} guida="guida-completa" idPrefix="home" titolo="Scarica la guida completa" testo="Inserisci la tua email: il download parte subito." />
    </div>
  </section>

  <section class="sec sec--sand" aria-labelledby="strumenti-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Strumenti gratuiti</span>
          <h2 class="h-l" id="strumenti-title">Calcoli, scadenze e lettere già pronte</h2>
        </div>
        <p class="lede">Strumenti semplici per fare i conti, non perdere una scadenza e scrivere a banca, condominio e fratelli senza partire da zero.</p>
      </div>
      <div class="grid grid--3">
        {TOOLS.map((t, i) => (
          <a class="card" href={t.href}>
            <span class="card__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="metodo-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Perché fidarsi</span>
          <h2 class="h-l" id="metodo-title">Fonti ufficiali, citate in ogni guida</h2>
        </div>
        <p class="lede">Ogni guida riporta la data di verifica e le fonti normative: Codice civile, Agenzia delle Entrate, Normattiva. Dove la legge lascia spazio a interpretazioni, lo diciamo. <a class="link" href="/metodo-editoriale/">Il nostro metodo</a></p>
      </div>
      <div class="grid grid--3">
        <article class="card"><span class="card__n">01</span><h3>Verificate sulle norme</h3><p>Ogni affermazione è controllata sul testo della legge o sui documenti dell'Agenzia delle Entrate, non su altri siti.</p></article>
        <article class="card"><span class="card__n">02</span><h3>Aggiornate</h3><p>Le regole cambiano: ogni guida porta la data dell'ultima verifica e le riforme già approvate, come i testi unici dal 2027.</p></article>
        <article class="card"><span class="card__n">03</span><h3>Oneste sui limiti</h3><p>Informazioni generali, non consulenza. Ti diciamo quando serve un notaio, un avvocato o un commercialista.</p></article>
      </div>
    </div>
  </section>

  <CtaBand />

  <script>
    const LINKS = {
      successione: { href: '/casa-ereditata/successione/', label: 'Come fare la dichiarazione di successione' },
      scadenze: { href: '/strumenti/scadenzario-successione/', label: 'Le tue scadenze' },
      disaccordo: { href: '/eredi-in-disaccordo/', label: 'Un erede non vuole vendere: cosa fare' },
      vendere: { href: '/casa-ereditata/vendere/', label: 'Come vendere una casa ereditata' },
      decidere: { href: '/casa-ereditata/decidere/', label: 'Vendere, affittare o tenere?' },
      valuta: { href: '/valuta-casa-ereditata/', label: 'Richiedi una valutazione gratuita' },
      tasse: { href: '/casa-ereditata/tasse/', label: 'Le tasse sulla casa ereditata' },
    } as const;
    type Key = keyof typeof LINKS;

    const form = document.getElementById('wizard') as HTMLFormElement;
    const out = document.getElementById('wizard-result') as HTMLDivElement;

    form.addEventListener('change', () => {
      const data = new FormData(form);
      const stato = data.get('stato');
      const accordo = data.get('accordo');
      const obiettivo = data.get('obiettivo');
      if (!stato || !accordo || !obiettivo) return;

      const steps: Key[] = [];
      if (stato !== 'fatta') steps.push('successione', 'scadenze');
      if (accordo === 'no') steps.push('disaccordo');
      if (obiettivo === 'vendere') steps.push('vendere', 'valuta');
      else if (obiettivo === 'capire') steps.push('decidere', 'valuta');
      else steps.push('decidere', 'tasse');

      out.replaceChildren();
      const h = document.createElement('p');
      h.innerHTML = '<strong>Il tuo percorso consigliato:</strong>';
      const ol = document.createElement('ol');
      for (const key of steps) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = LINKS[key].href;
        a.textContent = LINKS[key].label;
        li.append(a);
        ol.append(li);
      }
      out.append(h, ol);
      out.hidden = false;
    });
  </script>
</Base>
