---
/**
 * Registrazione per leggere l'intera guida: con Google o con l'email, senza password.
 * Sblocca tutte le guide in questo browser. Il PDF è una funzione separata (GuidaDownload).
 */
import { CONSENT_TEXT } from '../scripts/lead';
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID ?? '';
---
<div class="gate no-print" id="registrati" data-gate data-google-client={googleClientId}>
  <div class="gate__fade" aria-hidden="true"></div>
  <div class="gate__box">
    <span class="eyebrow" style="margin:0">Accesso gratuito</span>
    <h2 class="h-m">Registrati o autenticati per leggere l'intero contenuto</h2>
    <p>È gratis e senza password. Se ti sei già registrato, usa lo stesso account Google o la stessa email.</p>

    <div class="gate__google">
      <div data-google-button></div>
      <button class="btn btn-ghost gate__google-fallback" type="button" data-google-fallback>
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 38.2 44 33 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Registrati con Google
      </button>
    </div>

    <div class="gate__or"><span>oppure</span></div>

    <form data-gate-form novalidate>
      <div class="hp" aria-hidden="true"><label>Lascia vuoto <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="gate__row">
        <div class="field">
          <label for="gate-email">Registrati con email</label>
          <input id="gate-email" name="email" type="email" autocomplete="email" placeholder="nome@esempio.it" required />
        </div>
        <button class="btn" type="submit">Continua</button>
      </div>
      <label class="check">
        <input type="checkbox" name="consent_marketing" data-marketing />
        <span>{CONSENT_TEXT.marketing} (facoltativo)</span>
      </label>
      <p class="form-error" role="alert" data-error></p>
    </form>
    <p class="hint">Registrandoti dichiari di aver letto l'<a href="/privacy/" target="_blank">informativa privacy</a>. Titolare: Gromia S.r.l. I dati non vengono ceduti a terzi.</p>
  </div>
</div>

<script>
  import { formToObject, submitLead } from '../scripts/lead';
  import { unlock } from '../scripts/accesso';

  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const form = gate?.querySelector<HTMLFormElement>('[data-gate-form]');

  async function register(fields: Record<string, unknown>) {
    const marketing = gate?.querySelector<HTMLInputElement>('[data-marketing]')?.checked ?? false;
    try {
      await submitLead('registrazione', { ...fields, consent_marketing: marketing, guida: location.pathname });
    } catch (err) {
      // Se l'invio non va a buon fine non blocchiamo chi legge
      console.warn(err);
    }
    unlock(String(fields.email || ''));
    document.querySelector('.gated-rest')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  if (gate && form) {
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      if (!email.checkValidity() || !email.value) {
        error.textContent = 'Inserisci un indirizzo email valido.';
        return;
      }
      button.disabled = true;
      const f = formToObject(form);
      if (f.website) return;
      await register({ email: f.email, metodo: 'email' });
    });

    // Accesso con Google (Google Identity Services): attivo quando è configurato il client ID
    const clientId = gate.dataset.googleClient;
    const fallback = gate.querySelector<HTMLButtonElement>('[data-google-fallback]')!;
    const slot = gate.querySelector<HTMLElement>('[data-google-button]')!;
    if (clientId) {
      const s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client';
      s.async = true;
      s.onload = () => {
        const g = (window as any).google;
        g.accounts.id.initialize({
          client_id: clientId,
          callback: (resp: { credential: string }) => {
            const payload = JSON.parse(atob(resp.credential.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
            register({ email: payload.email, nome: payload.name, metodo: 'google', google_token: resp.credential });
          },
        });
        g.accounts.id.renderButton(slot, { theme: 'outline', size: 'large', text: 'signup_with', shape: 'rectangular', locale: 'it', width: 300 });
        fallback.hidden = true;
      };
      document.head.append(s);
    } else {
      fallback.addEventListener('click', () => {
        error.textContent = "L'accesso con Google sarà attivo a breve: intanto registrati con la tua email.";
        form.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
      });
    }
  }

  // Il pulsante in testata porta al download del PDF, che è separato dalla registrazione
  document.querySelector('[data-scarica-pdf]')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.querySelector('.pdf-box')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
