---
/** Registrazione o accesso (password o Google) per leggere l'intera guida. Il PDF è una funzione separata. */
import AuthForm from './AuthForm.astro';
---
<div class="gate no-print" id="registrati" data-gate>
  <div class="gate__fade" aria-hidden="true"></div>
  <div class="gate__box">
    <span class="eyebrow" style="margin:0">Accesso gratuito</span>
    <h2 class="h-m">Registrati o autenticati per leggere l'intero contenuto</h2>
    <p>Con un account gratuito leggi tutte le guide, usi gli strumenti e ritrovi tutto nella tua area riservata.</p>
    <AuthForm id="gate" />
  </div>
</div>

<script>
  document.addEventListener('ec:login', () => {
    document.querySelector('.gated-rest')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
