---
/** Invito a scaricare il PDF: il pulsante apre il modulo contatti (PdfLeadModal). */
interface Props {
  pdf: string;
  guida: string;
  titolo?: string;
  testo?: string;
  idPrefix?: string;
}
const {
  pdf,
  guida,
  titolo = 'Scarica questa guida in PDF',
  testo = 'Ricevi la versione stampabile da conservare o condividere con gli altri eredi.',
} = Astro.props;
---
<div class="download-box">
  <h3>{titolo}</h3>
  <p>{testo}</p>
  <a class="btn" href={pdf} data-pdf-open data-pdf={pdf} data-guida={guida}>Scarica il PDF</a>
</div>
