---
import ConsentFields from './ConsentFields.astro';

interface Props {
  // Prefisso per gli id dei campi: serve quando il modulo compare due volte nella stessa pagina
  idPrefix?: string;
}
const p = Astro.props.idPrefix ?? 'val';
---
<form class="form" data-valutazione-form novalidate>
  <p class="steps-indicator" aria-live="polite">Passo <span data-current>1</span> di 3</p>

  <div class="step" data-step="1">
    <h2>La casa</h2>
    <div class="row row--addr">
      <div class="field">
        <label for={`${p}-indirizzo`}>Indirizzo della casa</label>
        <input id={`${p}-indirizzo`} name="indirizzo" type="text" autocomplete="off" placeholder="Via o piazza, comune" required />
        <input type="hidden" name="comune" />
      </div>
      <div class="field">
        <label for={`${p}-civico`}>Civico</label>
        <input id={`${p}-civico`} name="civico" type="text" autocomplete="off" inputmode="text" maxlength="10" placeholder="es. 12/A" />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for={`${p}-tipologia`}>Tipo di immobile</label>
        <select id={`${p}-tipologia`} name="tipologia" required>
          <option value="">Seleziona</option>
          <option>Appartamento</option>
          <option>Casa indipendente o villa</option>
          <option>Rustico o casale</option>
          <option>Altro</option>
        </select>
      </div>
      <div class="field">
        <label for={`${p}-mq`}>Superficie (m²)</label>
        <input id={`${p}-mq`} name="mq" type="number" min="10" max="5000" inputmode="numeric" required />
      </div>
    </div>
    <div class="field">
      <label for={`${p}-occupazione`}>Stato attuale</label>
      <select id={`${p}-occupazione`} name="occupazione" required>
        <option value="">Seleziona</option>
        <option>Libera</option>
        <option>Abitata da un erede o dal coniuge</option>
        <option>Affittata</option>
      </select>
    </div>
  </div>

  <div class="step" data-step="2" hidden>
    <h2>La successione e gli eredi</h2>
    <div class="field">
      <label for={`${p}-successione`}>A che punto è la successione?</label>
      <select id={`${p}-successione`} name="successione" required>
        <option value="">Seleziona</option>
        <option>Non ancora iniziata</option>
        <option>In corso</option>
        <option>Dichiarazione presentata</option>
      </select>
    </div>
    <div class="row">
      <div class="field">
        <label for={`${p}-eredi`}>Quanti eredi?</label>
        <select id={`${p}-eredi`} name="eredi" required>
          <option value="">Seleziona</option>
          <option>1</option>
          <option>2</option>
          <option>3</option>
          <option>4 o più</option>
        </select>
      </div>
      <div class="field">
        <label for={`${p}-accordo`}>Gli eredi sono d'accordo sulla vendita?</label>
        <select id={`${p}-accordo`} name="accordo" required>
          <option value="">Seleziona</option>
          <option>Sì</option>
          <option>Non ancora deciso</option>
          <option>No</option>
          <option>Sono l'unico erede</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for={`${p}-obiettivo`}>Cosa vorresti fare?</label>
        <select id={`${p}-obiettivo`} name="obiettivo" required>
          <option value="">Seleziona</option>
          <option>Vendere</option>
          <option>Capire quanto vale prima di decidere</option>
          <option>Affittare</option>
          <option>Liquidare gli altri eredi</option>
        </select>
      </div>
      <div class="field">
        <label for={`${p}-tempi`}>Entro quando?</label>
        <select id={`${p}-tempi`} name="tempi" required>
          <option value="">Seleziona</option>
          <option>Entro 3 mesi</option>
          <option>Entro 6 mesi</option>
          <option>Entro un anno</option>
          <option>Non lo so ancora</option>
        </select>
      </div>
    </div>
  </div>

  <div class="step" data-step="3" hidden>
    <h2>Come ricontattarti</h2>
    <div class="row">
      <div class="field">
        <label for={`${p}-nome`}>Nome</label>
        <input id={`${p}-nome`} name="nome" type="text" autocomplete="given-name" required />
      </div>
      <div class="field">
        <label for={`${p}-cognome`}>Cognome</label>
        <input id={`${p}-cognome`} name="cognome" type="text" autocomplete="family-name" required />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for={`${p}-telefono`}>Telefono</label>
        <input id={`${p}-telefono`} name="telefono" type="tel" autocomplete="tel" required />
      </div>
      <div class="field">
        <label for={`${p}-email`}>Email</label>
        <input id={`${p}-email`} name="email" type="email" autocomplete="email" required />
      </div>
    </div>
    <div class="field">
      <label for={`${p}-note`}>Note</label>
      <textarea id={`${p}-note`} name="note" rows="3"></textarea>
    </div>
    <ConsentFields />
  </div>

  <p class="form-error" role="alert" data-error></p>
  <div class="form-actions">
    <button type="button" class="btn btn-ghost" data-prev hidden>Indietro</button>
    <button type="button" class="btn" data-next>Avanti</button>
    <button type="submit" class="btn" data-submit hidden>Richiedi la valutazione</button>
  </div>
</form>

<script>
  import { formToObject, submitLead } from '../scripts/lead';
  import { attachAutocomplete } from '../scripts/autocomplete';
  import { suggestAddresses } from '../scripts/geocoding';

  // Modulo a 3 passi: può comparire più volte (pagina dedicata e modale)
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-valutazione-form]')) {
    // Indirizzo con suggerimenti (Stadia Maps, solo Italia, come nel sito Gromia) e civico a parte
    const comune = form.querySelector<HTMLInputElement>('input[name="comune"]')!;
    const indirizzo = form.querySelector<HTMLInputElement>('input[name="indirizzo"]')!;
    const civico = form.querySelector<HTMLInputElement>('input[name="civico"]')!;
    attachAutocomplete(indirizzo, (t) => suggestAddresses(t), (pl) => {
      comune.value = pl.comune ?? '';
      // Il civico, se arriva dal suggerimento, va nel suo campo
      const m = pl.title.match(/^(.*?)\s+(\d+[a-z]?(?:\/\w+)?)$/i);
      if (m && pl.comune) {
        civico.value ||= m[2];
        pl = { ...pl, title: m[1] };
      }
      setTimeout(() => civico.focus(), 0);
      return pl.subtitle ? `${pl.title}, ${pl.subtitle}` : pl.title;
    });
    // Se l'indirizzo viene riscritto a mano, il comune scelto prima non vale più
    indirizzo.addEventListener('input', () => (comune.value = ''));
    // Senza un suggerimento scelto, il comune è la parte dopo la prima virgola ("Via Roma, Viareggio")
    form.addEventListener('submit', () => {
      if (!comune.value) comune.value = indirizzo.value.split(',')[1]?.trim() ?? '';
    }, true);

    const steps = Array.from(form.querySelectorAll<HTMLElement>('.step'));
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const current = form.querySelector<HTMLElement>('[data-current]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    let i = 0;

    const show = (n: number) => {
      i = n;
      steps.forEach((s, idx) => (s.hidden = idx !== n));
      prev.hidden = n === 0;
      next.hidden = n === steps.length - 1;
      submit.hidden = n !== steps.length - 1;
      current.textContent = String(n + 1);
      error.textContent = '';
    };

    const valid = (step: HTMLElement) => {
      const fields = Array.from(step.querySelectorAll<HTMLInputElement>('input, select, textarea'));
      const bad = fields.find((f) => !f.checkValidity());
      if (bad) {
        error.textContent = 'Completa i campi richiesti per continuare.';
        bad.focus();
        return false;
      }
      return true;
    };

    next.addEventListener('click', () => valid(steps[i]) && show(i + 1));
    prev.addEventListener('click', () => show(i - 1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!valid(steps[i])) return;
      // Invio con il tasto Invio nei passi intermedi: avanza invece di inviare
      if (i < steps.length - 1) return show(i + 1);
      submit.disabled = true;
      submit.textContent = 'Invio in corso…';
      try {
        await submitLead('valutazione', formToObject(form));
        location.href = '/grazie/';
      } catch {
        error.textContent = 'Invio non riuscito. Riprova tra poco o scrivici a info@ereditarecasa.it.';
        submit.disabled = false;
        submit.textContent = 'Richiedi la valutazione';
      }
    });
  }
</script>
