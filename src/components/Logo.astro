---
/** Logo: una casa grande e una piccola, la casa che passa da una generazione all'altra. */
interface Props {
  href?: string;
  dark?: boolean;
}
const { href = '/', dark = false } = Astro.props;
const big = dark ? '#fff5ec' : '#0f0f0f';
const small = dark ? '#e3cba9' : '#cbb08c';
const mask = dark ? 'logo-cut-d' : 'logo-cut';
const smallHouse = 'M30 41 44 28.5 58 41V57H30z';
---
<a class="logo" href={href} aria-label="EreditareCasa, pagina iniziale">
  <svg class="logo__mark" viewBox="2 8 58 51" width="38" height="33" aria-hidden="true">
    <defs>
      <mask id={mask}><rect width="64" height="64" fill="#fff" /><path d={smallHouse} fill="#000" stroke="#000" stroke-width="8" stroke-linejoin="round" /></mask>
    </defs>
    <path d="M5 28.5 23.5 11 42 28.5V57H5z" fill={big} stroke={big} stroke-width="3" stroke-linejoin="round" mask={`url(#${mask})`} />
    <path d={smallHouse} fill={small} stroke={small} stroke-width="3" stroke-linejoin="round" />
  </svg>
  <span>ereditare<b>casa</b></span>
</a>
