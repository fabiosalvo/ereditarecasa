---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ValutazioneModal from '../components/ValutazioneModal.astro';
import AuthModal from '../components/AuthModal.astro';
import PdfLeadModal from '../components/PdfLeadModal.astro';
import { SITE, TITOLARE } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Disattiva la modale di valutazione (pagina dedicata, pagine di stampa)
  noModal?: boolean;
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** Immagine di anteprima (URL assoluto); di default il marchio */
  image?: string;
  published?: Date;
  modified?: Date;
}

const { title, description, noindex = false, noModal = false, jsonLd = [], ogType = 'website', image, published, modified } = Astro.props;
const ogImage = image ?? `${SITE.url}/brand/og-image.png`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
// Il nome del sito va in coda solo se il titolo resta entro ~60 caratteri, oltre Google lo taglia
const fullTitle = title.includes(SITE.name) || title.length + SITE.name.length + 3 > 62 ? title : `${title} | ${SITE.name}`;
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: 'ereditarecasa.it',
  url: `${SITE.url}/`,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/logo.png`, width: 603, height: 161 },
  description: 'Guide verificate sulle fonti ufficiali per chi eredita una casa in Italia: successione, tasse, eredi, vendita.',
  areaServed: { '@type': 'Country', name: 'Italia' },
  knowsAbout: ['Successione ereditaria', 'Dichiarazione di successione', 'Imposta di successione', 'Casa ereditata', 'Divisione ereditaria', 'Vendita di immobili ereditati'],
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: TITOLARE.emailContatti, availableLanguage: 'Italian', areaServed: 'IT' },
};
// WebSite solo in home: dà a Google il nome del sito da mostrare nei risultati
const siteLd = Astro.url.pathname === '/'
  ? { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, alternateName: 'ereditarecasa.it', url: `${SITE.url}/`, inLanguage: 'it-IT', publisher: { '@id': `${SITE.url}/#organization` } }
  : null;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="it-IT" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="EreditareCasa: blog" href="/blog/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fffaf5" />
    <link rel="preload" href="/fonts/libre-franklin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify([orgLd, ...(siteLd ? [siteLd] : []), ...jsonLd])} />
  </head>
  <body>
    <script is:inline>try{if(localStorage.getItem('ec-accesso'))document.documentElement.classList.add('ec-logged')}catch(e){}</script>
    <a class="skip" href="#main">Vai al contenuto</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!noModal && <ValutazioneModal />}
    <AuthModal />
    <PdfLeadModal />
    <script>
      import { markLoggedIn, markLoggedOut, me } from '../scripts/accesso';
      // Allinea la pagina allo stato reale della sessione sul server
      const accountLink = () => {
        const link = document.querySelector<HTMLAnchorElement>('[data-account]');
        if (link) { link.href = '/area-riservata/'; link.textContent = 'Area riservata'; }
      };
      document.addEventListener('ec:unlocked', accountLink);
      me().then((u) => (u ? markLoggedIn(u) : markLoggedOut()));
    </script>
  </body>
</html>
